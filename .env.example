# =====================================================================
#  MẪU BIẾN MÔI TRƯỜNG (được commit vào repo làm tài liệu tham chiếu).
#  KHÔNG điền secret thật vào file này.
#
#  Cách dùng:
#   - Chạy local:  copy file này thành .env.local rồi điền (hoặc để trống = mock)
#                  cp .env.example .env.local
#   - Deploy thật: khai báo các biến dưới đây trong môi trường của nền tảng
#                  (Vercel/Docker/VPS...), KHÔNG commit giá trị thật.
# =====================================================================

# ---- MISA AMIS Kế toán (Open API) ----------------------------------
# Nguồn master data (NCC / hàng hóa / ĐVT / kho / phòng ban).
# Có ĐỦ 3 biến sau  -> chế độ LIVE (gọi MISA thật).
# Thiếu bất kỳ biến -> chế độ MOCK (dùng dữ liệu giả trong src/lib/misa/fixtures.ts).
#
#   app_id            : xin từ NVKD MISA khi đăng ký dùng Open API
#   access_code       : lấy trong AMIS Kế toán (tài khoản có quyền Admin dữ liệu)
#   org_company_code  : mã đơn vị/dữ liệu, xác nhận cùng NVKD MISA
MISA_APP_ID=your-misa-app-id
MISA_ACCESS_CODE=your-misa-access-code
MISA_ORG_COMPANY_CODE=your-org-company-code

# URL API MISA (mặc định nếu bỏ trống: https://actapp.misa.vn)
MISA_BASE_URL=https://actapp.misa.vn

# Tự đồng bộ MISA khi khởi động server (true/false). Mặc định true.
# false = chỉ đồng bộ thủ công qua nút trong Cấu hình.
MISA_AUTO_SYNC=true

# ---- CƠ SỞ DỮ LIỆU -------------------------------------------------
# CÓ DATABASE_URL  -> app nối thẳng PostgreSQL thật (Supabase).
# KHÔNG có          -> dùng PGlite nhúng (DB local ./.pglite), như mặc định.
#
# Lấy chuỗi ở: Supabase Dashboard -> Project Settings -> Database ->
# Connection string. KHUYÊN dùng "Connection pooling" (Supavisor, cổng 6543)
# cho app serverless/Next.js; thay [PASSWORD] bằng mật khẩu DB thật.
#   Pooler : postgresql://postgres.kenrqbkgammyivutnnfm:[PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Direct : postgresql://postgres:[PASSWORD]@db.kenrqbkgammyivutnnfm.supabase.co:5432/postgres
# DATABASE_URL=

# Nạp DỮ LIỆU MẪU (công ty/tài khoản/hàng hóa demo) khi khởi động.
# Chỉ có tác dụng ở chế độ Postgres. true = nạp demo để thử; để trống/false
# = KHÔNG nạp (dùng khi đã có tài khoản & dữ liệu thật trên Supabase).
# DB_SEED=false

# CHẾ ĐỘ "chỉ tài khoản trên Supabase": true = Supabase CHỈ giữ bảng users
# (accounts master); toàn bộ nghiệp vụ (PR/PO…) vẫn chạy PGlite local, còn
# users được đồng bộ 2 chiều theo email (kéo lúc khởi động, đẩy khi thêm/sửa/
# nhập Excel). Cần có DATABASE_URL. Xem src/lib/accounts.ts.
#   - Dọn Supabase còn mỗi bảng users: node scripts/supabase-accounts-only.mjs --yes
# ACCOUNTS_ONLY=true

# Số kết nối tối đa trong pool (mặc định 5). Tùy chọn.
# DB_POOL_MAX=5

# ---- ĐỒNG BỘ HÓA ĐƠN TỪ GOOGLE (Sheet + Drive của app thu gom hóa đơn) ----
# Đọc hóa đơn "Mua vào" từ Google Sheet rồi TỰ GHÉP vào PO theo NCC+mã+giá+tiền
# (không cần cột "Số PO"). Xác thực bằng SERVICE ACCOUNT (chỉ đọc).
#
# Cách lấy: tạo service account trên Google Cloud, bật Google Sheets API +
# Drive API, tải file khóa JSON, rồi CHIA SẺ (Viewer) Sheet + folder Drive cho
# email service account (…@…iam.gserviceaccount.com).
#
# Trên Vercel: dán NGUYÊN nội dung JSON vào GOOGLE_SERVICE_ACCOUNT_JSON.
# Local: có thể trỏ tới file bằng GOOGLE_SA_KEY_PATH (KHÔNG commit file JSON).
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SA_KEY_PATH=F:/duong-dan/khoa-service-account.json

# ID spreadsheet (đoạn giữa /d/…/edit của link Google Sheet).
# INVOICE_SHEET_ID=1vqgKzMAhfe0kDMcC7a2ZKEarzYvPgcNqs6yDO02kMSg

# Tên 2 tab trong Sheet (mặc định đúng như file hiện tại — chỉ đổi nếu tab khác tên).
# INVOICE_SHEET_TAB_HEADER=Hóa đơn
# INVOICE_SHEET_TAB_DETAIL=Chi tiết hàng hóa

# MST CÔNG TY MÌNH — Sheet gom hóa đơn của NHIỀU pháp nhân; đặt biến này để CHỈ
# đồng bộ hóa đơn mà MÌNH là bên MUA (tránh kéo hóa đơn của pháp nhân khác).
# COMPANY_TAX_ID=0317763152

# ---- DB NGHIỆP VỤ RIÊNG (Neon) khi ACCOUNTS_ONLY=true -----------------
# Khi accounts để ở Supabase (DATABASE_URL) nhưng muốn PR/PO/hóa đơn chạy trên
# Postgres thật (Neon) thay vì PGlite local: đặt BUSINESS_DATABASE_URL = chuỗi
# kết nối Neon. Bỏ trống = nghiệp vụ chạy PGlite local (như cũ).
# Lấy ở Neon Dashboard → Connect → Connection string (Pooled).
# BUSINESS_DATABASE_URL=postgresql://neondb_owner:<PASSWORD>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
